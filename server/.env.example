# Capacita Enterprise Server - Environment Variables
# Copy this file to .env and configure for your environment

# Security
SECRET_KEY=generate-a-strong-random-secret-key-for-production
DEBUG=False
ALLOWED_HOSTS=api.capacita.org,capacita.org,localhost,127.0.0.1

# Neon PostgreSQL Database Connection
# Format: postgresql://[user]:[password]@[neon-host]/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:npg_your_password@ep-proud-cloud-bdheu4lq-pooler.c-8.us-east-2.aws.neon.tech/neondb?sslmode=require

# CORS Allowed Origins (comma-separated frontend URLs)
CORS_ALLOWED_ORIGINS=https://capacita.org,https://app.capacita.org,http://localhost:5173

# JWT Configuration
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
