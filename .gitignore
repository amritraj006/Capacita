*.sqlite3
*.db

# Static & Media
staticfiles/
media/

# Node / Frontend
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS and Editor
.DS_Store
.idea/
.vscode/
*.swp
*.swo
